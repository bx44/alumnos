@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""
+Dibuja las palabras en hebreo del banco de kashiot.
+
+El font del juego no tiene letras hebreas, así que cada palabra se dibuja
+aquí como imagen y el juego la enseña como estampa. De paso el nikud queda
+bien puesto, cosa que un font de pixeles no sabría hacer.
+
+Se corre cuando agregas o cambias palabras en assets/orbarak/kashiot.txt:
+
+    python3 tools/palabras.py
+
+y deja dos archivos en assets/orbarak/: palabras.png y palabras.txt
+"""
+
+import os
+import sys
+from PIL import Image, ImageDraw, ImageFont, features
+
+RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+ASSETS = os.path.join(RAIZ, 'core', 'src', 'main', 'assets', 'orbarak')
+BANCO = os.path.join(ASSETS, 'kashiot.txt')
+
+FUENTE = '/usr/share/fonts/truetype/freefont/FreeSerif.ttf'
+TAMANO = 34            # alto de letra en pixeles
+ALTO_FILA = 44         # alto de cada renglón del atlas
+ANCHO = 256            # ancho del atlas
+TINTA = (255, 255, 255, 255)
+
+
+def palabras_del_banco():
+    salida = []
+    with open(BANCO, encoding='utf-8') as f:
+        for linea in f:
+            linea = linea.strip()
+            if not linea or linea.startswith('#'):
+                continue
+            c = linea.split('|')
+            if c[0].strip().upper() == 'T' and len(c) >= 4:
+                palabra = c[2].strip()
+                if palabra and palabra not in [p for p, _ in salida]:
+                    salida.append((palabra, c[3].strip()))
+    return salida
+
+
+def main():
+    if not features.check('raqm'):
+        print('AVISO: sin raqm el nikud y el orden de derecha a izquierda '
+              'pueden salir mal. Instala libraqm.', file=sys.stderr)
+
+    if not os.path.exists(FUENTE):
+        print('No encontré el font en ' + FUENTE, file=sys.stderr)
+        return 1
+
+    palabras = palabras_del_banco()
+    if not palabras:
+        print('No hay palabras tipo T en ' + BANCO)
+        return 1
+
+    fuente = ImageFont.truetype(FUENTE, TAMANO)
+    alto = ALTO_FILA * len(palabras)
+    atlas = Image.new('RGBA', (ANCHO, alto), (0, 0, 0, 0))
+    dibujo = ImageDraw.Draw(atlas)
+
+    indice = []
+    for i, (palabra, _) in enumerate(palabras):
+        y = i * ALTO_FILA
+        caja = dibujo.textbbox((0, 0), palabra, font=fuente)
+        ancho_palabra = min(ANCHO, caja[2] - caja[0] + 6)
+        x = (ANCHO - ancho_palabra) // 2
+        dibujo.text((ANCHO // 2, y + ALTO_FILA // 2), palabra,
+                    font=fuente, fill=TINTA, anchor='mm')
+        indice.append((palabra, x, y, ancho_palabra, ALTO_FILA))
+
+    atlas.save(os.path.join(ASSETS, 'palabras.png'))
+    with open(os.path.join(ASSETS, 'palabras.txt'), 'w', encoding='utf-8') as f:
+        f.write('# palabra|x|y|ancho|alto  ·  lo genera tools/palabras.py, no lo edites a mano\n')
+        for palabra, x, y, an, al in indice:
+            f.write('%s|%d|%d|%d|%d\n' % (palabra, x, y, an, al))
+
+    print('%d palabras dibujadas en %dx%d' % (len(palabras), ANCHO, alto))
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
