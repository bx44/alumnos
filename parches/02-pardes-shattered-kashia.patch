+package com.shatteredpixel.shatteredpixeldungeon.orbarak;
+
+import com.shatteredpixel.shatteredpixeldungeon.Dungeon;
+import com.shatteredpixel.shatteredpixeldungeon.Statistics;
+import com.shatteredpixel.shatteredpixeldungeon.actors.hero.Hero;
+import com.shatteredpixel.shatteredpixeldungeon.levels.features.LevelTransition;
+import com.shatteredpixel.shatteredpixeldungeon.scenes.GameScene;
+import com.shatteredpixel.shatteredpixeldungeon.utils.GLog;
+import com.watabou.utils.Callback;
+
+/**
+ * El portón de cada piso.
+ *
+ * Antes de bajar, una kashiá. Si le atinas te llevas jidushim, experiencia y
+ * algo de aire; si no, bajas igual con las manos vacías. Nunca se bloquea el
+ * paso: el que no sabe hoy baja y aprende, no se queda arriba castigado.
+ *
+ * Se engancha en Level.activateTransition con un solo renglón, para que las
+ * actualizaciones que saque Evan sigan entrando sin pelearse con esto.
+ */
+public class Porton {
+
+	/**
+	 * ¿Hay que preguntar antes de dejar pasar?
+	 * Devuelve true si se abrió la ventana; en ese caso el que llama no baja
+	 * todavía: la bajada la dispara la ventana al cerrarse.
+	 */
+	public static boolean intercepta(final Hero hero, final LevelTransition transicion) {
+		if (hero == null || transicion == null) return false;
+		if (transicion.type != LevelTransition.Type.REGULAR_EXIT
+				&& transicion.type != LevelTransition.Type.BRANCH_EXIT) {
+			return false;
+		}
+
+		final int piso = Dungeon.depth;
+		final Jazara jazara = Jazara.da();
+		if (jazara.yaPaso(piso)) return false;
+
+		final Kashia kashia = Kashia.saca(hondura(piso), jazara.yaSalieron);
+		if (kashia == null) return false;
+
+		jazara.anotaPaso(piso);
+
+		final WndKashia[] ventana = new WndKashia[1];
+		ventana[0] = new WndKashia("Portón del piso " + piso, kashia, new Callback() {
+			@Override
+			public void call() {
+				if (ventana[0].acerto()) premio(hero, piso, jazara);
+				Dungeon.level.activateTransition(hero, transicion);
+			}
+		});
+		GameScene.show(ventana[0]);
+		return true;
+	}
+
+	/** 1 Bet Hamidrash · 2 Los Salones · 3 El Cerro · 4 La Biblioteca · 5 El Pardés */
+	public static int hondura(int piso) {
+		int h = (piso + 4) / 5;
+		return h < 1 ? 1 : (h > 5 ? 5 : h);
+	}
+
+	private static void premio(Hero hero, int piso, Jazara jazara) {
+		int oro  = 20 + piso * 4 + Math.min(jazara.racha, 6) * 5;
+		int exp  = 4 + piso;
+		int aire = 3 + piso / 3;
+
+		Dungeon.gold += oro;
+		Statistics.goldCollected += oro;
+		hero.earnExp(exp, Porton.class);
+		if (hero.HP < hero.HT) {
+			hero.HP = Math.min(hero.HT, hero.HP + aire);
+			hero.sprite.showStatus(0x74C47C, "+%d", aire);
+		}
+
+		GLog.p("Pasas el portón. +%d de oro.", oro);
+	}
+}
