+package com.shatteredpixel.shatteredpixeldungeon.orbarak;
+
+import com.badlogic.gdx.Gdx;
+import com.watabou.utils.Random;
+
+import java.util.ArrayList;
+import java.util.Collections;
+
+/**
+ * Un reto del portón.
+ *
+ * Los retos viven en assets/orbarak/kashiot.txt, un archivo de texto plano que
+ * cualquiera puede editar sin programar. Hay de dos tipos:
+ *
+ *   P  pregunta de opción múltiple, con sus cuatro opciones y cuál es la buena.
+ *   T  una palabra en hebreo o arameo y lo que quiere decir. Las tres opciones
+ *      malas las arma el juego solo, tomando las traducciones de otras palabras,
+ *      así que para agregar una palabra basta con escribirla y su significado.
+ *
+ * Si el archivo no se puede leer, el juego sigue con el puñado de retos de
+ * emergencia que están aquí abajo: nunca se queda sin qué preguntar.
+ */
+public class Kashia {
+
+	public String  id;            // para acordarnos de cuál falló
+	public String  palabra;       // solo en las de traducir; si no, null
+	public String  pregunta;
+	public String  explicacion;
+	public String[] opciones;
+	public int     correcta;      // índice dentro de opciones
+	public int     hondura;       // 1 a 5
+
+	private static ArrayList<Kashia>   preguntas = null;
+	private static ArrayList<String[]> palabras  = null;   // {hondura, palabra, significado}
+
+	private static final String ARCHIVO = "orbarak/kashiot.txt";
+
+	private static final String[] DE_EMERGENCIA = {
+		"P|1|¿En qué idioma está escrita casi toda la Guemará?|Arameo|Hebreo|Griego|Ladino|1|Arameo babilonio.",
+		"P|1|¿Cuántos sedarim tiene la Mishná?|Cuatro|Seis|Diez|Doce|2|Seis.",
+		"P|2|Cuando la Guemará dice «teikú», la pregunta…|Se resolvió|Queda sin resolver|Era tonta|Cambia de tema|2|Queda parada.",
+		"T|1|אָמַר|dijo",
+		"T|1|תָּנָא|enseñó",
+		"T|2|תֵּירוּץ|respuesta",
+		"T|2|קוּשְׁיָא|pregunta difícil"
+	};
+
+	// ───────────────────────── carga ─────────────────────────
+
+	private static void cargar() {
+		if (preguntas != null) return;
+		preguntas = new ArrayList<>();
+		palabras  = new ArrayList<>();
+
+		String crudo = null;
+		try {
+			crudo = Gdx.files.internal(ARCHIVO).readString("UTF-8");
+		} catch (Exception e) {
+			crudo = null;
+		}
+		String[] lineas = (crudo != null && crudo.trim().length() > 0)
+				? crudo.split("\\r?\\n")
+				: DE_EMERGENCIA;
+
+		for (String linea : lineas) {
+			if (linea == null) continue;
+			linea = linea.trim();
+			if (linea.length() == 0 || linea.charAt(0) == '#') continue;
+
+			String[] c = linea.split("\\|", -1);
+			try {
+				if (c[0].equalsIgnoreCase("P") && c.length >= 8) {
+					Kashia k = new Kashia();
+					k.hondura  = acota(Integer.parseInt(c[1].trim()));
+					k.pregunta = c[2].trim();
+
+					ArrayList<String> ops = new ArrayList<>();
+					int buena = Integer.parseInt(c[7].trim()) - 1;
+					int corregida = 0;
+					for (int i = 0; i < 4; i++) {
+						String o = c[3 + i].trim();
+						if (o.length() == 0) continue;
+						if (i == buena) corregida = ops.size();
+						ops.add(o);
+					}
+					if (ops.size() < 2) continue;
+
+					k.opciones    = ops.toArray(new String[0]);
+					k.correcta    = corregida;
+					k.explicacion = c.length > 8 ? c[8].trim() : "";
+					k.id          = "p:" + k.pregunta;
+					preguntas.add(k);
+
+				} else if (c[0].equalsIgnoreCase("T") && c.length >= 4) {
+					String h = String.valueOf(acota(Integer.parseInt(c[1].trim())));
+					String palabra = c[2].trim(), significado = c[3].trim();
+					if (palabra.length() > 0 && significado.length() > 0) {
+						palabras.add(new String[]{ h, palabra, significado });
+					}
+				}
+			} catch (Exception e) {
+				// un renglón mal escrito no tumba el juego: se salta y ya
+			}
+		}
+	}
+
+	private static int acota(int h) {
+		return h < 1 ? 1 : (h > 5 ? 5 : h);
+	}
+
+	/** Para que al editar el archivo no haya que reiniciar en modo prueba. */
+	public static void recargar() {
+		preguntas = null;
+		palabras = null;
+		cargar();
+	}
+
+	public static int cuantasPreguntas() { cargar(); return preguntas.size(); }
+	public static int cuantasPalabras()  { cargar(); return palabras.size(); }
+
+	// ───────────────────────── sacar una ─────────────────────────
+
+	/** Un reto de la hondura pedida, sin repetir los que ya salieron esta partida. */
+	public static Kashia saca(int hondura, ArrayList<String> yaSalieron) {
+		cargar();
+		boolean hayPalabras = palabras.size() >= 4;
+		boolean traducir = hayPalabras && (preguntas.isEmpty() || Random.Float() < 0.45f);
+
+		Kashia k = traducir ? deTraduccion(hondura, yaSalieron) : deOpcion(hondura, yaSalieron);
+		if (k == null) k = traducir ? deOpcion(hondura, yaSalieron) : deTraduccion(hondura, yaSalieron);
+		if (k == null) {            // ya salieron todos: se permite repetir
+			k = traducir ? deTraduccion(hondura, null) : deOpcion(hondura, null);
+		}
+		return k;
+	}
+
+	private static Kashia deOpcion(int hondura, ArrayList<String> yaSalieron) {
+		ArrayList<Kashia> cerca = new ArrayList<>();
+		for (int margen = 0; margen <= 4 && cerca.isEmpty(); margen++) {
+			for (Kashia k : preguntas) {
+				if (Math.abs(k.hondura - hondura) > margen) continue;
+				if (yaSalieron != null && yaSalieron.contains(k.id)) continue;
+				cerca.add(k);
+			}
+		}
+		if (cerca.isEmpty()) return null;
+
+		Kashia base = Random.element(cerca);
+		Kashia k = new Kashia();        // copia, para poder revolver sin tocar el banco
+		k.id = base.id; k.hondura = base.hondura;
+		k.pregunta = base.pregunta; k.explicacion = base.explicacion;
+
+		ArrayList<String> ops = new ArrayList<>();
+		Collections.addAll(ops, base.opciones);
+		String buena = base.opciones[base.correcta];
+		Collections.shuffle(ops);
+		k.opciones = ops.toArray(new String[0]);
+		k.correcta = ops.indexOf(buena);
+		return k;
+	}
+
+	private static Kashia deTraduccion(int hondura, ArrayList<String> yaSalieron) {
+		if (palabras.size() < 4) return null;
+
+		ArrayList<String[]> cerca = new ArrayList<>();
+		for (int margen = 0; margen <= 4 && cerca.isEmpty(); margen++) {
+			for (String[] w : palabras) {
+				if (Math.abs(Integer.parseInt(w[0]) - hondura) > margen) continue;
+				if (yaSalieron != null && yaSalieron.contains("t:" + w[1])) continue;
+				cerca.add(w);
+			}
+		}
+		if (cerca.isEmpty()) return null;
+
+		String[] w = Random.element(cerca);
+
+		ArrayList<String> malas = new ArrayList<>();
+		for (String[] otra : palabras) {
+			if (!otra[2].equals(w[2])) malas.add(otra[2]);
+		}
+		if (malas.size() < 3) return null;
+		Collections.shuffle(malas);
+
+		ArrayList<String> ops = new ArrayList<>(malas.subList(0, 3));
+		ops.add(w[2]);
+		Collections.shuffle(ops);
+
+		Kashia k = new Kashia();
+		k.id          = "t:" + w[1];
+		k.hondura     = Integer.parseInt(w[0]);
+		k.palabra     = w[1];
+		k.pregunta    = "¿Qué quiere decir?";
+		k.opciones    = ops.toArray(new String[0]);
+		k.correcta    = ops.indexOf(w[2]);
+		k.explicacion = w[1] + " = " + w[2] + ".";
+		return k;
+	}
+
+	/** Vuelve a armar un reto a partir de su id, para repasar lo fallado. */
+	public static Kashia porId(String id) {
+		cargar();
+		if (id == null) return null;
+		if (id.startsWith("p:")) {
+			for (Kashia k : preguntas) {
+				if (id.equals(k.id)) return deOpcionFija(k);
+			}
+		} else if (id.startsWith("t:")) {
+			String palabra = id.substring(2);
+			for (String[] w : palabras) {
+				if (w[1].equals(palabra)) return deTraduccionFija(w);
+			}
+		}
+		return null;
+	}
+
+	private static Kashia deOpcionFija(Kashia base) {
+		ArrayList<String> ops = new ArrayList<>();
+		Collections.addAll(ops, base.opciones);
+		String buena = base.opciones[base.correcta];
+		Collections.shuffle(ops);
+		Kashia k = new Kashia();
+		k.id = base.id; k.hondura = base.hondura;
+		k.pregunta = base.pregunta; k.explicacion = base.explicacion;
+		k.opciones = ops.toArray(new String[0]);
+		k.correcta = ops.indexOf(buena);
+		return k;
+	}
+
+	private static Kashia deTraduccionFija(String[] w) {
+		ArrayList<String> malas = new ArrayList<>();
+		for (String[] otra : palabras) if (!otra[2].equals(w[2])) malas.add(otra[2]);
+		if (malas.size() < 3) return null;
+		Collections.shuffle(malas);
+		ArrayList<String> ops = new ArrayList<>(malas.subList(0, 3));
+		ops.add(w[2]);
+		Collections.shuffle(ops);
+
+		Kashia k = new Kashia();
+		k.id = "t:" + w[1];
+		k.hondura = Integer.parseInt(w[0]);
+		k.palabra = w[1];
+		k.pregunta = "¿Qué quiere decir?";
+		k.opciones = ops.toArray(new String[0]);
+		k.correcta = ops.indexOf(w[2]);
+		k.explicacion = w[1] + " = " + w[2] + ".";
+		return k;
+	}
+}
