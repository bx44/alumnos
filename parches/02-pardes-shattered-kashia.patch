+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>
+ */
+
+package com.shatteredpixel.shatteredpixeldungeon.orbarak;
+
+import com.badlogic.gdx.Gdx;
+import com.watabou.noosa.Image;
+
+import java.util.HashMap;
+
+/**
+ * Las palabras en hebreo, dibujadas de antemano.
+ *
+ * El font del juego no trae letras hebreas y un font de pixeles tampoco sabría
+ * acomodar el nikud, así que cada palabra viene ya dibujada en una sola imagen
+ * (orbarak/palabras.png) y aquí nada más se recorta la que toca.
+ *
+ * Para agregar palabras: las escribes en kashiot.txt y corres tools/palabras.py.
+ */
+public class Palabras {
+
+	public static final String ATLAS  = "orbarak/palabras.png";
+	private static final String INDICE = "orbarak/palabras.txt";
+
+	private static HashMap<String, int[]> donde = null;   // palabra -> {x, y, ancho, alto}
+
+	private static void cargar() {
+		if (donde != null) return;
+		donde = new HashMap<>();
+		try {
+			String crudo = Gdx.files.internal(INDICE).readString("UTF-8");
+			for (String linea : crudo.split("\\r?\\n")) {
+				linea = linea.trim();
+				if (linea.length() == 0 || linea.charAt(0) == '#') continue;
+				String[] c = linea.split("\\|");
+				if (c.length < 5) continue;
+				donde.put(c[0], new int[]{
+						Integer.parseInt(c[1].trim()), Integer.parseInt(c[2].trim()),
+						Integer.parseInt(c[3].trim()), Integer.parseInt(c[4].trim())
+				});
+			}
+		} catch (Exception e) {
+			// sin índice no hay estampas; el reto se ve sin la palabra y ni modo
+		}
+	}
+
+	public static boolean hay(String palabra) {
+		cargar();
+		return donde.containsKey(palabra);
+	}
+
+	/** La estampa de una palabra, o null si esa palabra no está dibujada. */
+	public static Image estampa(String palabra) {
+		cargar();
+		int[] r = donde.get(palabra);
+		if (r == null) return null;
+		try {
+			return new Image(ATLAS, r[0], r[1], r[2], r[3]);
+		} catch (Exception e) {
+			return null;
+		}
+	}
+}
