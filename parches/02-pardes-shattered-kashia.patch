+
+package com.shatteredpixel.shatteredpixeldungeon.orbarak;
+
+import com.shatteredpixel.shatteredpixeldungeon.Chrome;
+import com.shatteredpixel.shatteredpixeldungeon.scenes.PixelScene;
+import com.shatteredpixel.shatteredpixeldungeon.ui.RedButton;
+import com.shatteredpixel.shatteredpixeldungeon.ui.RenderedTextBlock;
+import com.shatteredpixel.shatteredpixeldungeon.ui.Window;
+import com.watabou.noosa.Image;
+import com.watabou.utils.Callback;
+
+/**
+ * El portón: una kashiá antes de bajar de piso.
+ *
+ * No se puede cerrar con el botón de atrás. Le atines o no, al final bajas:
+ * nadie se queda encerrado por no saber. Lo que cambia es qué te llevas.
+ */
+public class WndKashia extends Window {
+
+	private static final int ANCHO_P = 125;
+	private static final int ANCHO_L = 150;
+	private static final int MARGEN  = 2;
+	private static final int ALTO_BOTON = 18;
+
+	private static final int VERDE = 0x74C47C;
+	private static final int ROJO  = 0xDD5A4A;
+	private static final int ORO   = 0xFFD700;
+
+	private final Kashia kashia;
+	private final Callback alTerminar;
+	private boolean contestada = false;
+	private boolean acerto = false;
+
+	private RedButton[] botones;
+	private RenderedTextBlock cierre;
+
+	public WndKashia(String titulo, Kashia kashia, Callback alTerminar) {
+		super(0, 0, Chrome.get(Chrome.Type.WINDOW));
+		this.kashia = kashia;
+		this.alTerminar = alTerminar;
+
+		int ancho = PixelScene.landscape() ? ANCHO_L : ANCHO_P;
+		float pos = MARGEN;
+
+		RenderedTextBlock tTitulo = PixelScene.renderTextBlock(titulo, 9);
+		tTitulo.hardlight(TITLE_COLOR);
+		tTitulo.setPos(MARGEN, pos);
+		tTitulo.maxWidth(ancho - MARGEN * 2);
+		add(tTitulo);
+		pos = tTitulo.bottom() + 2 * MARGEN;
+
+		// la palabra en hebreo va como estampa, porque el font del juego no la tiene
+		if (kashia.palabra != null) {
+			Image palabra = Palabras.estampa(kashia.palabra);
+			if (palabra != null) {
+				float escala = Math.min(1f, (ancho - 2f * MARGEN) / palabra.width());
+				palabra.scale.set(escala);
+				palabra.x = (ancho - palabra.width() * escala) / 2f;
+				palabra.y = pos;
+				PixelScene.align(palabra);
+				add(palabra);
+				pos += palabra.height() * escala + 2 * MARGEN;
+			}
+		}
+
+		RenderedTextBlock tPregunta = PixelScene.renderTextBlock(kashia.pregunta, 6);
+		tPregunta.maxWidth(ancho);
+		tPregunta.setPos(0, pos);
+		add(tPregunta);
+		pos = tPregunta.bottom() + 2 * MARGEN;
+
+		botones = new RedButton[kashia.opciones.length];
+		for (int i = 0; i < kashia.opciones.length; i++) {
+			final int cual = i;
+			RedButton b = new RedButton(kashia.opciones[i]) {
+				@Override
+				protected void onClick() {
+					contesta(cual);
+				}
+			};
+			b.multiline = true;
+			add(b);
+			b.setRect(0, pos, ancho, ALTO_BOTON);
+			pos = b.bottom() + MARGEN;
+			botones[i] = b;
+		}
+
+		cierre = PixelScene.renderTextBlock(6);
+		cierre.maxWidth(ancho);
+		cierre.setPos(0, pos);
+		add(cierre);
+
+		resize(ancho, (int) (pos - MARGEN));
+	}
+
+	private void contesta(int cual) {
+		if (contestada) return;
+		contestada = true;
+		acerto = (cual == kashia.correcta);
+
+		Jazara j = Jazara.da();
+		j.anotaSalida(kashia.id);
+		if (acerto) j.anotaAcierto(kashia.id);
+		else        j.anotaError(kashia.id);
+
+		for (int i = 0; i < botones.length; i++) {
+			botones[i].enable(false);
+			if (i == kashia.correcta)      botones[i].textColor(VERDE);
+			else if (i == cual && !acerto) botones[i].textColor(ROJO);
+		}
+
+		StringBuilder txt = new StringBuilder();
+		txt.append(acerto ? "Eso es. " : "No era. ");
+		if (kashia.explicacion != null && kashia.explicacion.length() > 0) {
+			txt.append(kashia.explicacion);
+		}
+		if (acerto && j.racha > 1) txt.append("\nLlevas ").append(j.racha).append(" seguidas.");
+
+		cierre.text(txt.toString());
+		cierre.hardlight(acerto ? VERDE : ORO);
+
+		float pos = botones[botones.length - 1].bottom() + MARGEN;
+		cierre.setPos(0, pos);
+		pos = cierre.bottom() + 2 * MARGEN;
+
+		RedButton seguir = new RedButton(acerto ? "Pasar el portón" : "Bajar de todos modos") {
+			@Override
+			protected void onClick() {
+				hide();
+				if (alTerminar != null) alTerminar.call();
+			}
+		};
+		add(seguir);
+		seguir.setRect(0, pos, PixelScene.landscape() ? ANCHO_L : ANCHO_P, ALTO_BOTON);
+
+		resize(PixelScene.landscape() ? ANCHO_L : ANCHO_P, (int) seguir.bottom());
+	}
+
+	public boolean acerto() {
+		return acerto;
+	}
+
+	/** Mientras no conteste, el botón de atrás no la cierra. */
+	@Override
+	public void onBackPressed() {
+		if (contestada) {
+			super.onBackPressed();
+		}
+	}
+}
