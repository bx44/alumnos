+package com.shatteredpixel.shatteredpixeldungeon.orbarak;
+
+import com.shatteredpixel.shatteredpixeldungeon.Dungeon;
+import com.shatteredpixel.shatteredpixeldungeon.actors.buffs.Buff;
+import com.watabou.utils.Bundle;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashSet;
+
+/**
+ * La memoria de la partida: qué portones ya pasaste, qué retos ya te salieron,
+ * cuáles fallaste y cómo vas de rachas.
+ *
+ * Va colgado del alumno como un efecto invisible, y por eso se guarda y se
+ * recupera solo junto con la partida, sin tocar el sistema de guardado.
+ */
+public class Jazara extends Buff {
+
+	public  ArrayList<Integer> portonesPasados = new ArrayList<>();
+	public  ArrayList<String>  yaSalieron      = new ArrayList<>();
+	public  ArrayList<String>  falladas        = new ArrayList<>();
+
+	public int aciertos  = 0;
+	public int errores   = 0;
+	public int racha     = 0;
+	public int mejorRacha = 0;
+
+	{
+		revivePersists = true;
+	}
+
+	public static Jazara da() {
+		return Buff.affect(Dungeon.hero, Jazara.class);
+	}
+
+	public boolean yaPaso(int piso) {
+		return portonesPasados.contains(piso);
+	}
+
+	public void anotaPaso(int piso) {
+		if (!portonesPasados.contains(piso)) portonesPasados.add(piso);
+	}
+
+	public void anotaSalida(String id) {
+		if (id == null) return;
+		yaSalieron.add(id);
+		// si ya salieron casi todas, se olvida de las más viejas para poder repetir
+		while (yaSalieron.size() > 60) yaSalieron.remove(0);
+	}
+
+	public void anotaAcierto(String id) {
+		aciertos++;
+		racha++;
+		if (racha > mejorRacha) mejorRacha = racha;
+		falladas.remove(id);
+	}
+
+	public void anotaError(String id) {
+		errores++;
+		racha = 0;
+		if (id != null && !falladas.contains(id) && falladas.size() < 20) falladas.add(id);
+	}
+
+	/** Un reto que hayas fallado antes, para repasarlo. Null si no debes nada. */
+	public Kashia paraRepasar() {
+		while (!falladas.isEmpty()) {
+			String id = falladas.get(0);
+			Kashia k = Kashia.porId(id);
+			if (k != null) return k;
+			falladas.remove(0);     // ese reto ya no existe en el banco
+		}
+		return null;
+	}
+
+	private static final String PORTONES = "portones";
+	private static final String SALIERON = "salieron";
+	private static final String FALLADAS = "falladas";
+	private static final String ACIERTOS = "aciertos";
+	private static final String ERRORES  = "errores";
+	private static final String RACHA    = "racha";
+	private static final String MEJOR    = "mejor_racha";
+
+	@Override
+	public void storeInBundle(Bundle bundle) {
+		super.storeInBundle(bundle);
+		int[] pisos = new int[portonesPasados.size()];
+		for (int i = 0; i < pisos.length; i++) pisos[i] = portonesPasados.get(i);
+		bundle.put(PORTONES, pisos);
+		bundle.put(SALIERON, yaSalieron.toArray(new String[0]));
+		bundle.put(FALLADAS, falladas.toArray(new String[0]));
+		bundle.put(ACIERTOS, aciertos);
+		bundle.put(ERRORES,  errores);
+		bundle.put(RACHA,    racha);
+		bundle.put(MEJOR,    mejorRacha);
+	}
+
+	@Override
+	public void restoreFromBundle(Bundle bundle) {
+		super.restoreFromBundle(bundle);
+		portonesPasados.clear();
+		for (int p : bundle.getIntArray(PORTONES)) portonesPasados.add(p);
+		yaSalieron = new ArrayList<>(Arrays.asList(bundle.getStringArray(SALIERON)));
+		falladas   = new ArrayList<>(new LinkedHashSet<>(Arrays.asList(bundle.getStringArray(FALLADAS))));
+		aciertos   = bundle.getInt(ACIERTOS);
+		errores    = bundle.getInt(ERRORES);
+		racha      = bundle.getInt(RACHA);
+		mejorRacha = bundle.getInt(MEJOR);
+	}
+}
